# ============================================================
# ByChat_IMG repository exclusions
# ============================================================

# Hidden local/tool state directories (.deploy, .venv, .pytest_cache,
# .codex, .agents, .vscode, .idea, etc.). Git's own .git directory is
# metadata and is never added to the repository.
**/.[!.]*/
**/..?*/

# Archived prototypes and local working copies. This directory may contain
# browser caches, generated images, copied repositories, and local API keys.
legacy/

# Server/local environment files. Keep sanitized templates only.
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template

# Deployment runtime, managed Python, release snapshots, backups, and locks.
.deploy/
**/.deploy/
deploy.lock
*.pid
*.pid.lock
*.sock

# Python environments, caches, coverage, packages, and build output.
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
wheelhouse/
htmlcov/
.coverage
.coverage.*
coverage.xml
pytestdebug.log

# JavaScript dependencies, caches, logs, and build output.
node_modules/
.npm/
.yarn/
.pnpm-store/
.parcel-cache/
.next/
.nuxt/
.svelte-kit/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data and generated user content.
logs/
*.log
tmp/
temp/
cache/
uploads/
downloads/
generated_images/
.local_dev_cache/
*.sqlite
*.sqlite3
*.db
*.db-journal

# Credentials, private keys, certificates with private material, and local
# package/CLI authentication files.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials.json
credentials.*.json
service-account*.json
secrets.json
secrets.*
.npmrc
.pypirc
.netrc

# IDE, OS, swap, and backup files not already covered by hidden directories.
*.swp
*.swo
*~
*.bak
*.tmp
.DS_Store
Thumbs.db
Desktop.ini

# Internal/local documentation. The public repository uses README.md.
CODEX_ANALYSIS.md
PLAN.md
CODE_REVIEW.md
DEPLOY.md
OVERVIEW.md

# Keep the public tools directory focused. Local probes and browser automation
# remain available in the working copy but are not published.
tools/*
!tools/_common.sh
!tools/start_backend.sh
!tools/install_service.sh
!tools/diag.sh
!tools/sync_model_capabilities.py
!tools/tests/
tools/tests/*
!tools/tests/test_deploy.py
