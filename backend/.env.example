# ============================================================
# 服务器自己的运行参数。这里**不存放任何用户数据**。
# 用户的 API 地址与 Key 由浏览器在每次请求时通过请求头带来，服务器用完即弃。
# ============================================================

# 网站公开使用，无站点访问密码；API Key 由各用户在浏览器内填写。

# 允许转发到的上游 host，逗号分隔。
# 这是 SSRF 防护：上游地址由浏览器传入，不校验的话本服务会变成请求跳板，
# 可被用于探测内网或读取 169.254.169.254 云厂商元数据。
# 填 * 表示允许任意公网 host（但仍会拒绝内网 / 回环 / 链路本地地址）。
UPSTREAM_ALLOWLIST=api.bingyun.vip

# 设为 true 时放行内网 / 回环地址。仅当上游确实跑在内网时才打开，
# 打开后上面的 IP 保护失效，请自行承担风险。
ALLOW_PRIVATE_UPSTREAM=false

# 上游超时（秒）。生图较慢，读超时给得宽一些。
CONNECT_TIMEOUT=10
READ_TIMEOUT=180
WRITE_TIMEOUT=30

# 聊天 mode=auto 时，首选协议（如 /responses）这么久还没吐出第一个字，
# 就并发起备选协议（/chat/completions）一起等，谁先吐字用谁——不是放弃首选，
# 两个会一起跑一小段时间。默认 30 秒来自实测（该上游 /responses 首字约 21~28 秒）。
# 调小：备选介入更早，遇到"首选没坏只是偶尔慢"时会多打一次上游请求；
# 调大：更倾向于死等首选，减少并发请求次数但也更晚才有备选兜底。
AUTO_FIRST_TOKEN_TIMEOUT=30

# 生图 / 改图遇到网关层的暂时性失败（502/503/522/524，且响应头没有
# x-request-id / x-client-request-id——说明请求根本没到源站、或源站还在处理）
# 时，允许自动重试的总时间预算（秒）。外层网络设施的请求超时应大于这个值。
IMAGE_RETRY_BUDGET_SECONDS=250

# 视频是异步任务：后端提交后轮询上游直到出结果。这是允许轮询的总时长预算（秒）。
# 视频越长越慢（15 秒 1080p 可能要几分钟），超预算会明确报「超时」而不是无限等下去。
VIDEO_POLL_BUDGET_SECONDS=600

# 生图 / 改图前用来"解析图片需求"的辅助**文本**模型。留空 = 后端自动从上游模型
# 列表里挑一个聊天模型（推荐留空）。
# 不建议写死：写死的模型名换中转站后必然失效。2026-10-12 的真实故障就是这里写死成
# 上游没有的 gpt-5.6-sol，于是所有图像模型都被误报成「该模型当前不可用」。
IMAGE_PLAN_MODEL=

HOST=0.0.0.0
PORT=7391
